<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="13dp"
        android:paddingVertical="@dimen/marginAlignMedium">

        <ImageView
            android:id="@+id/ivTrackIcon"
            android:layout_width="@dimen/posterSizeSmall"
            android:layout_height="@dimen/posterSizeSmall"
            android:contentDescription="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivTrackDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/baseline_keyboard_arrow_right_24" />

        <TextView
            android:id="@+id/tvTrackName"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginHorizontal="@dimen/marginAlignMedium"
            android:textAppearance="@style/YSRegular16"
            android:textColor="?attr/colorOnSecondary"
            app:layout_constraintBottom_toTopOf="@id/tvTrackAuthor"
            app:layout_constraintEnd_toStartOf="@+id/ivTrackDetails"
            app:layout_constraintStart_toEndOf="@id/ivTrackIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="She loves you" />

        <TextView
            android:id="@+id/tvTrackAuthor"
            android:layout_width="0dp"
            app:layout_constraintWidth_default="wrap"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/marginAlignMedium"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/YSRegular11"
            android:textColor="?attr/colorPrimaryVariant"
            app:layout_constraintTop_toBottomOf="@id/tvTrackName"
            app:layout_constraintStart_toEndOf="@id/ivTrackIcon"
            app:layout_constraintEnd_toStartOf="@id/ivDelimiter"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="The Beatles" />

        <ImageView
            android:id="@+id/ivDelimiter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            app:layout_constraintStart_toEndOf="@id/tvTrackAuthor"
            app:layout_constraintEnd_toStartOf="@id/tvDuration"
            app:layout_constraintBottom_toBottomOf="@id/tvTrackAuthor"
            app:srcCompat="@drawable/dot" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/marginAlignMedium"
            android:textAppearance="@style/YSRegular11"
            android:textColor="?attr/colorPrimaryVariant"
            app:layout_constraintStart_toEndOf="@id/ivDelimiter"
            app:layout_constraintBottom_toBottomOf="@id/ivDelimiter"
            app:layout_constraintEnd_toStartOf="@+id/ivTrackDetails"
            tools:text="3:00" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>