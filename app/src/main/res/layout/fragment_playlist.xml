<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/Base.Secondary"
        tools:context=".presentation.ui.media.fragments.playlist.PlaylistFragment">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToCreatePlaylist"
            style="@style/ErrorButtonStyle"
            android:layout_marginTop="@dimen/marginAlignXXLarge"
            android:text="@string/create_playlist"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivPlaylistPlaceHolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="106dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/empty_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPlaylistMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/marginAlignLarge"
            android:text="@string/empty_playlist"
            android:textAppearance="@style/YSMedium19"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivPlaylistPlaceHolder" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>