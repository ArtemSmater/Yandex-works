<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainButtonStyle">
        <item name="android:layout_marginVertical">4dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/black</item>
        <item name="cornerRadius">@dimen/marginAlignMedium</item>
        <item name="android:textAppearance">@style/YSMediumFont</item>
    </style>

    <style name="FrameLayoutStyle">
        <item name="android:layout_height">61dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingHorizontal">@dimen/marginAlignMedium</item>
        <item name="android:paddingVertical">@dimen/marginAlignMedium</item>
    </style>

    <style name="SettingsItemsText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAppearance">@style/YSRegularFont</item>
    </style>

    <style name="SettingsItemsIcons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="contentDescription">@string/app_name</item>
    </style>
    
    <style name="YSMediumFont">
        <item name="android:textSize">@dimen/textSizeLage</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="YSRegularFont">
        <item name="android:textSize">@dimen/textSizeMedium</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>
</resources>