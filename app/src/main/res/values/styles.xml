<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_marginVertical">@dimen/marginAlignSmall</item>
        <item name="android:layout_marginHorizontal">@dimen/marginAlignLarge</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:textColor">@color/black_light</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/black_light</item>
        <item name="cornerRadius">@dimen/marginAlignMedium</item>
        <item name="android:textAppearance">@style/YSMedium22_500</item>
    </style>

    <style name="FrameLayoutStyle">
        <item name="android:layout_height">61dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingHorizontal">@dimen/marginAlignMedium</item>
        <item name="android:paddingVertical">@dimen/marginAlignMedium</item>
    </style>

    <style name="SettingsItemsText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/marginAlignLarge</item>
        <item name="android:paddingVertical">@dimen/marginAlignXLarge</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAppearance">@style/YSRegular16</item>
    </style>

    <style name="SettingsItemsIcons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <style name="TracksTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/marginAlignMedium</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TracksTextStyleSmall" parent="TracksTextStyle">
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="ErrorButtonStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">@dimen/marginAlignXXLarge</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAppearance">@style/YSMedium14_500</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:visibility">gone</item>
        <item name="cornerRadius">54dp</item>
    </style>

    <style name="PlayerLeftTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:layout_marginStart">@dimen/marginAlignXXLarge</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textAppearance">@style/YSRegular13_400</item>
        <item name="layout_constraintHorizontal_chainStyle">spread_inside</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="PlayerRightTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/marginAlignXXLarge</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAppearance">@style/YSRegular13_400</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <!--fonts-->
    
    <style name="YSMedium22_500">
        <item name="android:textSize">@dimen/textSizeXLage</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="YSMedium22_400">
        <item name="android:textSize">@dimen/textSizeXLage</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="YSMedium19">
        <item name="android:textSize">@dimen/textSizeLarge</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="YSMedium19Bold">
        <item name="android:textSize">@dimen/textSizeLarge</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="YSMedium14_500">
        <item name="android:textSize">@dimen/textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="YSMedium14_400">
        <item name="android:textSize">@dimen/textSize</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="YSRegular13_400">
        <item name="android:textSize">@dimen/textSize1</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="YSRegular16">
        <item name="android:textSize">@dimen/textSizeMedium</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="YSRegular11">
        <item name="android:textSize">@dimen/textSizeSmall</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>
</resources>